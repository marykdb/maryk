---
import MarkdownContent from '@astrojs/starlight/components/MarkdownContent.astro';
---

<MarkdownContent><slot /></MarkdownContent>

<script>
    const diagrams = new Map<HTMLElement, { source: string; id: string }>();
    let nextId = 0;
    let pending = Promise.resolve();

    async function renderDiagrams() {
        const blocks = document.querySelectorAll<HTMLPreElement>('pre[data-language="mermaid"]');
        if (!blocks.length && !diagrams.size) return;

        // Keep the renderer off pages which contain no diagrams.
        const { default: mermaid } = await import('mermaid');
        const dark = document.documentElement.dataset.theme === 'dark';
        const text = dark ? '#eef6fc' : '#183348';
        const line = dark ? '#b4d6e9' : '#536e88';
        mermaid.initialize({
            startOnLoad: false,
            securityLevel: 'strict',
            suppressErrorRendering: true,
            theme: 'base',
            themeVariables: {
                primaryColor: dark ? '#213b50' : '#e4f1fa',
                primaryTextColor: text,
                primaryBorderColor: dark ? '#78bdd5' : '#4b829f',
                lineColor: line,
                textColor: text,
                secondaryColor: dark ? '#343353' : '#ece6fa',
                tertiaryColor: dark ? '#213d3b' : '#e3f3ed',
                actorBkg: dark ? '#213b50' : '#e4f1fa',
                actorBorder: line,
                actorTextColor: text,
                signalColor: line,
                signalTextColor: text,
                labelBoxBkgColor: dark ? '#162330' : '#f5f9fb',
                labelTextColor: text,
            },
            fontFamily: '-apple-system, BlinkMacSystemFont, Segoe UI, sans-serif',
            flowchart: { htmlLabels: false },
        });

        const renderedNow = new Set<HTMLElement>();
        for (const block of blocks) {
            const lines = block.querySelectorAll('.ec-line');
            const source = lines.length
                ? Array.from(lines, line => line.textContent ?? '').join('\n')
                : block.querySelector('code')?.textContent ?? block.textContent ?? '';
            const figure = document.createElement('figure');
            figure.className = 'maryk-diagram not-content';
            const output = document.createElement('div');
            output.className = 'diagram-output';
            const caption = document.createElement('figcaption');
            caption.textContent = source.match(/^\s*accTitle:\s*(.+)$/m)?.[1] ?? 'Diagram';
            figure.append(caption, output);
            const id = `maryk-diagram-${nextId++}`;
            try {
                const { svg } = await mermaid.render(id, source);
                output.innerHTML = svg;
                const wrapper = block.closest('.expressive-code') ?? block;
                // Expressive Code puts shared styles and scripts in the first block.
                // Keep them when replacing a diagram so later code blocks stay styled.
                wrapper.before(...wrapper.querySelectorAll('style, link[rel="stylesheet"], script'));
                wrapper.replaceWith(figure);
                diagrams.set(figure, { source, id });
                renderedNow.add(figure);
            } catch (error) {
                // The original, readable Mermaid block remains available on failure.
                console.error('Could not render documentation diagram', error);
            }
        }
        for (const [figure, { source, id }] of diagrams) {
            if (!figure.isConnected) {
                diagrams.delete(figure);
                continue;
            }
            if (renderedNow.has(figure)) continue;
            const { svg } = await mermaid.render(id, source);
            figure.querySelector('.diagram-output')!.innerHTML = svg;
        }
    }

    function queueRender() {
        pending = pending.then(renderDiagrams).catch(error => {
            console.error('Could not initialize documentation diagrams', error);
        });
    }

    queueRender();
    document.addEventListener('astro:page-load', queueRender);
    new MutationObserver(queueRender).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
    });
</script>
